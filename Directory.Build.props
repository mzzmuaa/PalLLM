<!--
  Root-level MSBuild props inherited by every project in the solution.
  See https://learn.microsoft.com/dotnet/msbuild/customize-your-build —
  centralizing cross-project properties here keeps PalLLM.Domain.csproj
  and PalLLM.Sidecar.csproj in sync without copy-pasting.

  Keep this file small. Project-specific tuning belongs in the
  per-project .csproj; only settings that should apply to EVERY project
  go here.
-->
<Project>

  <PropertyGroup>
    <!--
      Warnings we deliberately suppress repo-wide, with rationale:

      CS1591 — "Missing XML comment for publicly visible type or member."
        We still want XML docs to be GENERATED (see GenerateDocumentationFile
        in each .csproj) because IntelliSense / harvesters rely on them,
        but we do NOT want 3_000+ missing-doc warnings for wire-contract
        records whose positional parameters are self-documenting. Types
        that are user-facing config surfaces (PalLlmOptions, its sub-option
        classes) carry hand-written <summary> tags; positional-parameter
        records in Integration/ rely on their <record summary> and
        contextual naming.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      Pass 425: enforce the long-standing 0-warning discipline structurally.
      The repo has shipped at 0 warnings for hundreds of passes by hand; this
      makes a regression FAIL the build instead of relying on the operator
      noticing. Scope note: this escalates compiler + Roslyn-analyzer
      *warning*-severity diagnostics (CSxxxx, CAxxxx). It does NOT touch
      IDExxxx code-STYLE rules — those stay at `suggestion` in .editorconfig
      and are not build-enforced (EnforceCodeStyleInBuild stays off), so this
      flip cannot surface a wall of style noise. If a future SDK band
      introduces a new analyzer warning, that is a real signal to address,
      caught immediately rather than drifting in.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Reproducible-build hygiene: deterministic compilation so identical
      source produces byte-identical output regardless of build path or
      machine. (Defaults to true on modern SDKs; stated explicitly as a
      contract alongside global.json's SDK pin.)
    -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
